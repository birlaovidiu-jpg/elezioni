rules_version = '2';

// Regole del database per il programma Elezioni e Votazioni.
// Da incollare in Firebase → Firestore Database → Regole → Pubblica.
//
// Chi lavora:
//  - il Direttore (nome utente «ovidio») vede e può tutto;
//  - le persone che il Direttore aggiunge (utenti/{uid} con attivo = true) vedono e lavorano
//    solo le sessioni che hanno creato loro;
//  - chi vota entra con un numero anonimo e vede solo la votazione del codice che ha.
//
// Segretezza del voto:
//  - la scheda va nell'urna SENZA nome e SENZA ora (una voce con chiave a caso);
//  - "votati" dice solo CHI ha votato (per non votare due volte), non COSA;
//  - nessuno può leggere l'urna finché il segretario non preme «Fine votazione».

service cloud.firestore {
  match /databases/{database}/documents {

    function entrato() { return request.auth != null; }
    function direttore() {
      return request.auth != null && request.auth.token.email == 'ovidio@elezioni-sdarm.firebaseapp.com';
    }
    function utente() {
      return request.auth != null
        && exists(/databases/$(database)/documents/utenti/$(request.auth.uid))
        && get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data.attivo == true;
    }
    // Su quali tipi di sessione può lavorare (assemblea, chiesa, comitato, consiglio): lo sceglie il Direttore.
    function tipiUtente() {
      return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data
        .get('tipi', ['assemblea', 'chiesa', 'comitato', 'consiglio']);
    }
    function segretario(s) {
      return direttore() || (utente()
        && get(/databases/$(database)/documents/sessioni/$(s)).data.get('owner', '') == request.auth.uid
        && get(/databases/$(database)/documents/sessioni/$(s)).data.get('tipo', '') in tipiUtente());
    }
    function testo(x, min, max) { return x is string && x.size() >= min && x.size() <= max; }

    // Le persone che lavorano con il programma: le aggiunge solo il Direttore.
    match /utenti/{uid} {
      allow read: if direttore() || (entrato() && request.auth.uid == uid);
      allow write: if direttore();
    }

    // Nome utente e password di ognuno: li legge solo il Direttore.
    // Ognuno può scrivere i suoi (quando entra o cambia la password), ma non leggerli da qui.
    match /credenziali/{uid} {
      allow read: if direttore();
      allow write: if direttore() || (entrato() && request.auth.uid == uid);
    }

    match /sessioni/{s} {
      // Il codice della sessione basta per leggerla (serve a chi vota);
      // l'elenco delle sessioni invece lo vede solo chi le ha create, e il Direttore.
      allow get: if entrato();
      allow list: if direttore() || (utente() && resource.data.owner == request.auth.uid);
      allow create: if request.resource.data.owner == request.auth.uid
        && (direttore() || (utente() && request.resource.data.tipo in tipiUtente()));
      // Una sessione chiusa resta chiusa (solo il Direttore potrebbe riaprirla).
      allow update: if segretario(s)
        && (direttore() || (request.resource.data.get('owner', '') == resource.data.get('owner', '')
            && !(resource.data.get('chiusa', false) == true && request.resource.data.get('chiusa', false) != true)));
      // Eliminare una sessione: chi l'ha creata e il Direttore (prima si cancella tutto quello che c'è dentro).
      allow delete: if segretario(s);

      // Registrazione di chi vota: nome, cognome, ruolo o incarico, chiesa.
      match /iscritti/{uid} {
        allow read: if entrato() && (request.auth.uid == uid || segretario(s));
        allow create, update: if entrato() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/sessioni/$(s))
          && get(/databases/$(database)/documents/sessioni/$(s)).data.get('chiusa', false) != true
          && request.resource.data.keys().hasOnly(['nome', 'cognome', 'ruolo', 'chiesa', 't', 'uscito'])
          && testo(request.resource.data.nome, 1, 60)
          && testo(request.resource.data.cognome, 1, 60)
          && testo(request.resource.data.ruolo, 1, 60)
          && testo(request.resource.data.chiesa, 0, 80)
          // «uscito» lo mette e lo toglie solo il segretario
          && request.resource.data.get('uscito', null) == (resource == null ? null : resource.data.get('uscito', null));
        // Il segretario segna chi esce dalla sala (e chi rientra), con l'ora.
        allow update: if segretario(s) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uscito']);
        // Il segretario può togliere chi si è registrato per errore.
        allow delete: if segretario(s);
      }

      match /votazioni/{v} {
        allow read: if entrato();
        // Nessuna votazione nuova quando la sessione è chiusa.
        allow create: if segretario(s)
          && get(/databases/$(database)/documents/sessioni/$(s)).data.get('chiusa', false) != true;
        allow update, delete: if segretario(s);

        // Solo CHI ha votato (vuoto: nessun contenuto).
        match /votati/{uid} {
          allow read: if entrato() && (request.auth.uid == uid || segretario(s));
          allow create: if entrato() && request.auth.uid == uid
            && request.resource.data.keys().size() == 0
            && get(/databases/$(database)/documents/sessioni/$(s)/votazioni/$(v)).data.stato == 'aperta'
            && get(/databases/$(database)/documents/sessioni/$(s)).data.get('chiusa', false) != true
            && exists(/databases/$(database)/documents/sessioni/$(s)/iscritti/$(uid))
            // chi è uscito dalla sala non vota
            && get(/databases/$(database)/documents/sessioni/$(s)/iscritti/$(uid)).data.get('uscito', null) == null;
          allow delete: if segretario(s);
        }
      }

      // L'urna: un solo documento per votazione, le schede sono voci con chiave a caso.
      match /urne/{v} {
        allow delete: if segretario(s);
        allow read: if segretario(s)
          && get(/databases/$(database)/documents/sessioni/$(s)/votazioni/$(v)).data.stato == 'chiusa';
        allow create: if segretario(s)
          && request.resource.data.keys().hasOnly(['schede'])
          && request.resource.data.schede.size() == 0;
        // Una scheda sola, messa insieme al segno «ha votato», da chi non aveva ancora votato.
        allow update: if entrato()
          && get(/databases/$(database)/documents/sessioni/$(s)/votazioni/$(v)).data.stato == 'aperta'
          && !exists(/databases/$(database)/documents/sessioni/$(s)/votazioni/$(v)/votati/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/sessioni/$(s)/votazioni/$(v)/votati/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schede'])
          && request.resource.data.schede.diff(resource.data.schede).addedKeys().size() == 1
          && request.resource.data.schede.diff(resource.data.schede).removedKeys().size() == 0
          && request.resource.data.schede.diff(resource.data.schede).changedKeys().size() == 0;
      }

      // Risultati salvati dal segretario dopo «Fine votazione».
      match /risultati/{v} {
        allow read, write: if segretario(s);
      }
    }
  }
}
